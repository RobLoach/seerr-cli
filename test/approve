#!/usr/bin/env bash
# Tests for seerr. Run them with: test/approve
#
# Each test runs a seerr command and compares its output with the approved
# output in test/approvals/. When the output is new or has changed, you see
# the difference and are asked whether to approve it. In CI, any difference
# fails the tests.
cd "$(dirname "$0")"
source approvals.bash

rm -rf tmp
mkdir -p tmp/home
export HOME=$PWD/tmp/home LC_ALL=C
unset SEERR_URL SEERR_API_KEY SEERR_CONFIG SEERR_TIMEOUT SEERR_HTTP_CLIENT XDG_CONFIG_HOME

# Stands in for seerr_request: answers API requests from fixtures/ instead of
# a Seerr server, and logs them for `sent`. The fixture is named after the
# path, so GET /movie/10378 reads fixtures/movie-10378.json. Set fake_status and
# fake_body to answer with something else.
# shellcheck disable=SC2034 # seerr reads the variables this sets
fake_request() {
  local fixture=${2#/}
  fixture=fixtures/${fixture//[^a-zA-Z0-9]/-}.json

  echo "$1 $2${3:+ $3}" >>tmp/requests
  seerr_error=""
  if [[ -n ${fake_status:-} ]]; then
    seerr_status=$fake_status seerr_body=${fake_body:-}
  elif [[ -f $fixture ]]; then
    seerr_status=200 seerr_body=$(<"$fixture")
  else
    seerr_status=404 seerr_body='{"message": "not found"}'
  fi
}
export -f fake_request

# Run a seerr command with fake_request in place of seerr_request, showing
# stderr in the output and the home directory as ~. Each command gets its
# own bash, because approvals.bash runs commands where set -e is ignored, and
# seerr relies on it to stop at errors.
seerr() {
  : >tmp/requests
  bash -c 'source ../seerr; seerr_request() { fake_request "$@"; }; start "$@"' seerr "$@" 2>&1 | sed "s|$HOME|~|g"
  return "${PIPESTATUS[0]}"
}

# Print the API requests the last seerr command made. They're sorted, because
# title lookups run in parallel.
sent() {
  sort tmp/requests
}

describe "config"
  it "shows what isn't set"
    approve "seerr config show"

  it "saves settings to a file only you can read"
    approve "seerr config set url https://seerr.example.com"
    approve "echo abcd1234efgh | seerr config set api_key"
    approve "cat ~/.config/seerr/seerr-cli.yaml" "config_file"
    approve "ls -l ~/.config/seerr/seerr-cli.yaml | cut -c1-10" "config_file_permissions"
    approve "seerr config show" "config_show_saved"

  it "prefers flags, then environment variables, to the config file"
    approve "SEERR_URL=https://env.example seerr -u https://flag.example config show"

  it "rejects a bad value"
    approve "seerr config set url ftp://seerr.example.com"
    expect_exit_code 1

  it "shows the settings, then fails, when the config file has a bad value"
    echo "timeout: soon" >>~/.config/seerr/seerr-cli.yaml
    approve "seerr config show" "config_show_bad_value"
    expect_exit_code 1

rm ~/.config/seerr/seerr-cli.yaml
export SEERR_URL=https://seerr.example.com SEERR_API_KEY=test-key

describe "title lookup"
  it "takes a number as a TMDB ID"
    approve "seerr movie 10378"

  it "prefers an exact title to the first result"
    approve "seerr movie Sintel"

  it "keeps only results from --year"
    approve "seerr movie Sintel --year 2025"

  it "skips an exact title that few people have voted on"
    approve "seerr movie Bunny"

  it "searches for a number when --year is given"
    approve "seerr movie 1080 --year 2012"

  it "gives up after three pages of results"
    approve "seerr movie Blender --year 1921"
    expect_exit_code 1
    approve "sent" "sent_movie_blender_1921"

  it "looks up an IMDb ID"
    approve "seerr movie tt1727587"

  it "looks up an imdb.com URL, keeping the result of the right type"
    approve "seerr request create tv https://www.imdb.com/title/tt0046643/?ref_=fn_al_tt_1"
    approve "sent" "sent_request_create_imdb"

  it "fails when the IMDb ID is not that type"
    approve "seerr movie tt0046643"
    expect_exit_code 1

  it "fails when the IMDb ID matches nothing"
    approve "seerr movie tt0000000"
    expect_exit_code 1

describe "commands"
  it "searches"
    approve "seerr search Sintel"

  it "searches by IMDb or TVDB ID"
    approve "seerr search --imdb https://m.imdb.com/title/tt1727587/"
    approve "seerr search --tvdb 78855"

  it "fails when a searched ID matches nothing"
    approve "seerr search --imdb tt0000000"
    expect_exit_code 1

  it "needs search terms or an ID, not both"
    approve "seerr search"
    expect_exit_code 1
    approve "seerr search Sintel --tvdb 78855"
    expect_exit_code 1
    approve "seerr search --imdb 1727587"
    expect_exit_code 1

  it "shows a TV show and its seasons"
    approve "seerr tv 6560"

  it "lists requests with their titles"
    approve "seerr request list"

  it "requests a TV show"
    approve "seerr request create tv 6560 --seasons 1 --4k"
    approve "sent" "sent_request_create"

  it "fails when Seerr creates no request"
    approve "fake_status=202 fake_body='{\"message\": \"No seasons available to request\"}' seerr request create tv 6560" "request_create_no_seasons"
    expect_exit_code 1
    approve "sent" "sent_request_create_all_seasons"

  it "fails when the response has no request ID"
    approve "fake_status=201 fake_body='{\"id\": null, \"status\": 2}' seerr request create movie 10378" "request_create_null_id"
    expect_exit_code 1

  it "approves a request"
    approve "seerr request approve 12"

  it "reports an issue"
    approve "seerr issue create movie 10378 'Audio is out of sync' --problem audio"
    approve "sent" "sent_issue_create"

  it "only reports issues for media in Seerr"
    approve "seerr issue create movie 9761 'No sound'"
    expect_exit_code 1

describe "errors"
  it "explains a rejected API key"
    approve "fake_status=403 fake_body='{\"error\": \"Forbidden\"}' seerr whoami" "error_api_key"
    expect_exit_code 1

  it "rejects a response that isn't JSON"
    approve "fake_status=200 fake_body='<html>Sign in</html>' seerr whoami" "error_not_json"
    expect_exit_code 1
