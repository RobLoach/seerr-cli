normalize_input() {
  local arg passthru flags
  passthru=false

  while [[ $# -gt 0 ]]; do
    arg="$1"
    if [[ $passthru == true ]]; then
      input+=("$arg")
    elif [[ $arg =~ ^(--[a-zA-Z0-9_\-]+)=(.+)$ ]]; then
      input+=("${BASH_REMATCH[1]}")
      input+=("${BASH_REMATCH[2]}")
    elif [[ $arg =~ ^(-[a-zA-Z0-9])=(.+)$ ]]; then
      input+=("${BASH_REMATCH[1]}")
      input+=("${BASH_REMATCH[2]}")
    elif [[ $arg =~ ^-([a-zA-Z0-9][a-zA-Z0-9]+)$ ]]; then
      flags="${BASH_REMATCH[1]}"
      for ((i = 0; i < ${#flags}; i++)); do
        input+=("-${flags:i:1}")
      done
    elif [[ "$arg" == "--" ]]; then
      passthru=true
      input+=("$arg")
    else
      input+=("$arg")
    fi

    shift
  done
}

seerr_settings_resolve() {
  seerr_config_locate
  seerr_config_url=""
  seerr_config_api_key=""
  seerr_config_timeout=""
  seerr_config_http_client=""
  if [[ -f $seerr_config_file ]]; then
    seerr_config_read "$seerr_config_file"
  fi

  if [[ ${1:-} != lenient ]]; then
    seerr_config_check
  fi

  # The first value that isn't empty wins: flag, then environment, then file.
  seerr_url=${args[--url]:-${SEERR_URL:-$seerr_config_url}}
  seerr_api_key=${args[--api-key]:-${SEERR_API_KEY:-$seerr_config_api_key}}
  seerr_timeout=${SEERR_TIMEOUT:-${seerr_config_timeout:-30}}
  seerr_http_client=${SEERR_HTTP_CLIENT:-${seerr_config_http_client:-${deps[http_client]##*/}}}

  seerr_url=${seerr_url%/}
  seerr_url=${seerr_url%/api/v1}
}

seerr_config_check() {
  local key var error

  if [[ -n $seerr_config_file && ! -f $seerr_config_file ]]; then
    seerr_die "config file not found: $seerr_config_file"
  fi

  for key in url timeout http_client; do
    var=seerr_config_$key
    error=$(seerr_config_validate "$key" "${!var}")
    if [[ -n $error ]]; then
      seerr_die "$key in $seerr_config_file: $error"
    fi
  done
}

seerr_config_validate() {
  if [[ -z $2 ]]; then
    return
  fi

  case $1 in
    url) validate_url "$2" ;;
    timeout) validate_positive_integer "$2" ;;
    http_client) validate_http_client "$2" ;;
  esac
}

seerr_config_locate() {
  local explicit=${args[--config]:-${SEERR_CONFIG:-}}
  local candidate

  seerr_config_file=""
  if [[ -n $explicit ]]; then
    seerr_config_file=$explicit
    return
  fi

  while IFS= read -r candidate; do
    if [[ -f $candidate ]]; then
      seerr_config_file=$candidate
      return
    fi
  done < <(seerr_config_candidates)
}

seerr_config_candidates() {
  local base=${XDG_CONFIG_HOME:-$HOME/.config}

  printf '%s\n' "$base/seerr/seerr-cli.yaml" "$base/seerr-cli.yaml" "$HOME/.seerr-cli.yaml"
}

seerr_config_read() {
  local line key value

  [[ -r $1 ]] || seerr_die "cannot read config file: $1"

  while IFS= read -r line; do
    key=${line%%=*}
    value=${line#*=}
    value=${value#\"}
    value=${value%\"}
    value=${value%"${value##*[![:space:]]}"}

    case $key in
      url) seerr_config_url=$value ;;
      api_key) seerr_config_api_key=$value ;;
      timeout) seerr_config_timeout=$value ;;
      http_client) seerr_config_http_client=$value ;;
    esac
  done < <(yaml_load "$1")
}

seerr_config_write() {
  local file=$1 key=$2 value=$3
  local line found="" lines=()

  if [[ -f $file ]]; then
    while IFS= read -r line || [[ -n $line ]]; do
      if [[ $line =~ ^${key}[[:space:]]*: ]]; then
        if [[ -n $found ]]; then
          continue
        fi
        line="$key: $value"
        found=1
      fi
      lines+=("$line")
    done <"$file"
  fi

  if [[ -z $found ]]; then
    lines+=("$key: $value")
  fi

  (
    umask 077
    mkdir -p "$(dirname "$file")"
    : >>"$file"
  )
  chmod 600 "$file"
  printf '%s\n' "${lines[@]}" >"$file"
}

seerr_api() {
  seerr_require_settings
  seerr_request "$@"

  case $seerr_status in
    2??)
      if [[ -z $seerr_body ]]; then
        return
      fi
      if ! jq empty <<<"$seerr_body" 2>/dev/null; then
        seerr_die "$seerr_url did not answer with JSON. Check that the URL points at Seerr itself, not a login page or another service."
      fi
      printf '%s\n' "$seerr_body"
      ;;
    000) seerr_die "$(seerr_connect_error)" ;;
    *) seerr_die "$(seerr_http_error)" ;;
  esac
}

seerr_require_id() {
  local message

  if jq -e '.id != null' >/dev/null 2>&1 <<<"$1"; then
    return
  fi

  message=$(seerr_message "$1")
  seerr_die "no $2 created: ${message:-the response had no ID}${3:+$'\n'$3}"
}

seerr_request() {
  local method=$1 path=$2 body=${3:-}
  local tmp

  tmp=$(mktemp -d)
  # shellcheck disable=SC2064 # expand $tmp now; it is local to this function
  trap "rm -rf '$tmp'" EXIT
  if [[ -n $body ]]; then
    printf '%s' "$body" >"$tmp/request"
  fi

  if [[ $seerr_http_client == wget ]]; then
    seerr_request_wget "$method" "$seerr_url/api/v1$path" "$tmp"
  else
    seerr_request_curl "$method" "$seerr_url/api/v1$path" "$tmp"
  fi

  seerr_body=""
  if [[ -f $tmp/body ]]; then
    seerr_body=$(<"$tmp/body")
  fi
  rm -rf "$tmp"
  trap - EXIT
}

seerr_request_curl() {
  local method=$1 url=$2 tmp=$3
  local options=(-sS -X "$method" -o "$tmp/body" -w '%{http_code}' --max-time "$seerr_timeout" -H 'Accept: application/json')

  if [[ -f $tmp/request ]]; then
    options+=(-H 'Content-Type: application/json' --data-binary "@$tmp/request")
  fi

  seerr_status=$(curl "${options[@]}" -H @<(printf 'X-Api-Key: %s\n' "$seerr_api_key") "$url" 2>"$tmp/error") || true
  seerr_error=$(<"$tmp/error")
  seerr_error=${seerr_error#curl: (*) }
}

seerr_request_wget() {
  local method=$1 url=$2 tmp=$3
  local options=(-nv -S -O "$tmp/body" --content-on-error --max-redirect=0 --tries=1 --timeout="$seerr_timeout" --method="$method" --header='Accept: application/json')

  if [[ -f $tmp/request ]]; then
    options+=(--header='Content-Type: application/json' --body-file="$tmp/request")
  fi

  printf 'header = X-Api-Key: %s\n' "$seerr_api_key" >"$tmp/wgetrc"
  wget --config="$tmp/wgetrc" "${options[@]}" "$url" 2>"$tmp/error" || true

  seerr_status=$(sed -n 's/^ *HTTP\/[0-9.]* \([0-9][0-9][0-9]\).*/\1/p' "$tmp/error" | tail -n 1)
  seerr_status=${seerr_status:-000}
  seerr_error=$(grep -v '^ ' "$tmp/error" | tail -n 1) || true
}

seerr_message() {
  jq -r '.message // .error // empty' <<<"$1" 2>/dev/null || true
}

seerr_http_error() {
  local message

  message=$(seerr_message "$seerr_body")
  printf 'HTTP %s%s' "$seerr_status" "${message:+: $message}"

  case $seerr_status in
    401 | 403) printf '\nCheck that your API key is correct (seerr config show).' ;;
    3??) printf '\nThe server redirected the request. Check the URL, e.g. http vs https.' ;;
  esac
}

seerr_connect_error() {
  printf 'could not reach %s%s' "$seerr_url" "${seerr_error:+: $seerr_error}"

  if [[ ${seerr_error,,} == *"timed out"* ]]; then
    printf '\nGave up after %ss. To wait longer, set SEERR_TIMEOUT or run: seerr config set timeout SECONDS' "$seerr_timeout"
  fi
}

seerr_require_settings() {
  if [[ -z $seerr_url ]]; then
    seerr_die "no Seerr URL set. Use --url, SEERR_URL, or 'url:' in the config file (see seerr --help)."
  fi
  if [[ -z $seerr_api_key ]]; then
    seerr_die "no API key set. Use --api-key, SEERR_API_KEY, or 'api_key:' in the config file (see seerr --help)."
  fi
}

seerr_query() {
  local query="" separator="?"

  while (($# >= 2)); do
    if [[ -n $2 ]]; then
      query+="$separator$1=$(jq -rn --arg value "$2" '$value | @uri')"
      separator="&"
    fi
    shift 2
  done

  printf '%s' "$query"
}

seerr_skip() {
  echo $(((${args[--page]} - 1) * ${args[--take]}))
}

seerr_tmdb_resolve() {
  local type=$1 query=$2 year=${args[--year]:-}
  local json pick answer page=1 pages
  local -a matches=()
  local filter='
    [.results[]
      | select(.mediaType == $type)
      | select($year == "" or ((.releaseDate // .firstAirDate) | year) == $year)
      | {
          id,
          label: (title_year | one_line),
          votes: (.voteCount // 0),
          exact: ((.title // .name | ascii_downcase) == ($query | ascii_downcase))
        }]
    | . as $all
    | [$all[] | select(.exact)] as $exact
    | ([$exact[].votes, ($all[0].votes // 0)] | max) as $top
    | [$exact[] | select(.votes * 10 >= $top)][:10] as $choices
    | if ($choices | length) > 0 then $choices else $all[:1] end
    | .[]
    | "\(.id)\t\(.label)"'

  seerr_tmdb_match=""
  if [[ $query =~ ^[0-9]+$ && -z $year ]]; then
    seerr_tmdb_id=$query
    return
  fi

  while true; do
    json=$(seerr_api GET "/search$(seerr_query query "$query" page "$page" language "${args[--language]:-}")")
    mapfile -t matches < <(jq -r --arg type "$type" --arg year "$year" --arg query "$query" "$(seerr_jq_defs) $filter" <<<"$json")
    pages=$(jq -r '.totalPages // 1' <<<"$json")
    if ((${#matches[@]} > 0 || page >= pages || page >= 3)); then
      break
    fi
    page=$((page + 1))
  done

  if ((${#matches[@]} == 0)); then
    seerr_die "no $type found matching '$query'${year:+ from $year}. Try 'seerr search \"$query\"'."
  fi

  pick=${matches[0]}
  if ((${#matches[@]} > 1)) && [[ -t 0 && -t 2 ]]; then
    printf 'Several matches for "%s":\n' "$query" >&2
    for answer in "${!matches[@]}"; do
      printf '  %d) %s, TMDB ID %s\n' $((answer + 1)) "${matches[answer]#*$'\t'}" "${matches[answer]%%$'\t'*}" >&2
    done

    while true; do
      read -r -p "Which one? [1-${#matches[@]}, default 1] " answer || seerr_die "no match chosen"
      answer=${answer:-1}
      if [[ $answer =~ ^[0-9]+$ ]] && ((answer >= 1 && answer <= ${#matches[@]})); then
        pick=${matches[answer - 1]}
        break
      fi
      printf 'Enter a number from 1 to %d.\n' "${#matches[@]}" >&2
    done
  fi

  seerr_tmdb_id=${pick%%$'\t'*}
  seerr_tmdb_match=${pick#*$'\t'}
}

seerr_die() {
  printf 'seerr: %s\n' "$*" >&2
  exit 1
}

seerr_table() {
  local json=$1 filter=$2 rows
  shift 2

  if [[ -n ${args[--json]:-} ]]; then
    jq . <<<"$json"
    return
  fi

  rows=$(jq -r "$@" "$(seerr_jq_defs) ($filter) | map(if . == null or . == \"\" then \"-\" else (tostring | one_line) end) | join(\"\\t\")" <<<"$json") ||
    seerr_die "could not read the response from $seerr_url"
  if [[ -n $rows ]]; then
    seerr_columns <<<"$rows"
  fi
}

seerr_footer() {
  if [[ -n ${args[--json]:-} ]]; then
    return
  fi

  echo
  jq -r "$(seerr_jq_defs) $2" <<<"$1"
