parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --version | -v)
        version_command
        exit
        ;;

      --help | -h)
        long_usage=yes
        seerr_usage
        exit
        ;;

      --url | -u)

        if [[ -n ${2+x} ]]; then
          args['--url']="$2"
          shift
          shift
        else
          printf "%s\n" "--url requires an argument: --url, -u URL" >&2
          exit 1
        fi
        ;;

      --api-key | -k)

        if [[ -n ${2+x} ]]; then
          args['--api-key']="$2"
          shift
          shift
        else
          printf "%s\n" "--api-key requires an argument: --api-key, -k KEY" >&2
          exit 1
        fi
        ;;

      --config | -c)

        if [[ -n ${2+x} ]]; then
          args['--config']="$2"
          shift
          shift
        else
          printf "%s\n" "--config requires an argument: --config, -c PATH" >&2
          exit 1
        fi
        ;;

      *)
        break
        ;;

    esac
  done

  env_var_names+=("SEERR_URL")
  env_var_names+=("SEERR_API_KEY")
  env_var_names+=("SEERR_CONFIG")
  env_var_names+=("SEERR_HTTP_CLIENT")
  env_var_names+=("SEERR_TIMEOUT")
  if [[ -n "${SEERR_HTTP_CLIENT:-}" ]] && [[ ! ${SEERR_HTTP_CLIENT:-} =~ ^(curl|wget)$ ]]; then
    printf "%s\n" "SEERR_HTTP_CLIENT environment variable must be one of: curl, wget" >&2
    exit 1
  fi

  if [[ -v SEERR_URL ]]; then
    validation_output="$(validate_url "$SEERR_URL")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in environment variable %s:\n%s\n" "SEERR_URL" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v SEERR_HTTP_CLIENT ]]; then
    validation_output="$(validate_http_client "$SEERR_HTTP_CLIENT")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in environment variable %s:\n%s\n" "SEERR_HTTP_CLIENT" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v SEERR_TIMEOUT ]]; then
    validation_output="$(validate_positive_integer "$SEERR_TIMEOUT")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in environment variable %s:\n%s\n" "SEERR_TIMEOUT" "$validation_output" >&2
      exit 1
    fi
  fi

  missing_deps=

  if ! command -v curl wget >/dev/null 2>&1; then
    printf "missing dependency: http_client (curl/wget)\n" >&2
    printf "%s\n\n" "Install curl or wget" >&2
    missing_deps=1
  else
    deps['http_client']="$(command -v curl wget | head -n1)"
  fi

  if ! command -v jq >/dev/null 2>&1; then
    printf "missing dependency: jq\n" >&2
    printf "%s\n\n" "Install jq from https://jqlang.org" >&2
    missing_deps=1
  else
    deps['jq']="$(command -v jq | head -n1)"
  fi

  if [[ -n $missing_deps ]]; then
    exit 1
  fi

  action=${1:-}

  case $action in
    -*) ;;

    search)
      action="search"
      shift
      seerr_search_parse_requirements "$@"
      shift $#
      ;;

    trending)
      action="trending"
      shift
      seerr_trending_parse_requirements "$@"
      shift $#
      ;;

    movie)
      action="movie"
      shift
      seerr_movie_parse_requirements "$@"
      shift $#
      ;;

    tv)
      action="tv"
      shift
      seerr_tv_parse_requirements "$@"
      shift $#
      ;;

    media)
      action="media"
      shift
      seerr_media_parse_requirements "$@"
      shift $#
      ;;

    request | requests)
      action="request"
      shift
      seerr_request_parse_requirements "$@"
      shift $#
      ;;

    issue | issues)
      action="issue"
      shift
      seerr_issue_parse_requirements "$@"
