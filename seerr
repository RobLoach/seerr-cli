before_hook() {
  case $action in
    # Completions don't talk to Seerr, so a broken config shouldn't stop them.
    completions) ;;
    # `config set` may create the config file, or fix a bad value in it.
    # `config show` shows the settings before saying what is wrong with them.
    "config set" | "config show") seerr_settings_resolve lenient ;;
    *) seerr_settings_resolve ;;
  esac

}

initialize() {
  declare -g version="0.1.0"
  set -e

}

run() {

  declare -g long_usage=''
  declare -g -A args=()
  declare -g -A deps=()
  declare -g -a env_var_names=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"
  before_hook

  case "$action" in
    "search") seerr_search_command ;;
    "trending") seerr_trending_command ;;
    "movie") seerr_movie_command ;;
    "tv") seerr_tv_command ;;
    "media") seerr_media_command ;;
    "media list") seerr_media_list_command ;;
    "request") seerr_request_command ;;
    "request list") seerr_request_list_command ;;
    "request get") seerr_request_get_command ;;
    "request create") seerr_request_create_command ;;
    "request approve") seerr_request_approve_command ;;
    "request decline") seerr_request_decline_command ;;
    "request retry") seerr_request_retry_command ;;
    "request delete") seerr_request_delete_command ;;
    "request count") seerr_request_count_command ;;
    "issue") seerr_issue_command ;;
    "issue list") seerr_issue_list_command ;;
    "issue create") seerr_issue_create_command ;;
    "issue get") seerr_issue_get_command ;;
    "issue comment") seerr_issue_comment_command ;;
    "issue resolve") seerr_issue_resolve_command ;;
    "issue reopen") seerr_issue_reopen_command ;;
    "status") seerr_status_command ;;
    "whoami") seerr_whoami_command ;;
    "user") seerr_user_command ;;
    "user list") seerr_user_list_command ;;
    "user get") seerr_user_get_command ;;
    "api") seerr_api_command ;;
    "config") seerr_config_command ;;
    "config show") seerr_config_show_command ;;
    "config set") seerr_config_set_command ;;
    "completions") seerr_completions_command ;;
  esac
}

start() {
  if [[ ${1:-} == "__complete" ]]; then
    completion_run "${@:2}"
    return
  fi

  command_line_args=("$@")
  initialize
  run "${command_line_args[@]}"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  start "$@"
fi
