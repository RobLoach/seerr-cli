seerr_jq_defs() {
  cat <<'JQ'
def lookup(names): if . == null then null else (names[tostring] // tostring) end;
def request_status: lookup({"1": "pending", "2": "approved", "3": "declined", "4": "failed", "5": "completed"});
def media_status: lookup({"1": "unknown", "2": "pending", "3": "processing", "4": "partial", "5": "available", "6": "blocklisted", "7": "deleted"});
def issue_type: lookup({"1": "video", "2": "audio", "3": "subtitles", "4": "other"});
def issue_status: lookup({"1": "open", "2": "resolved"});
def user_type: lookup({"1": "plex", "2": "local", "3": "jellyfin", "4": "emby"});
def user_name: .displayName // .username // .plexUsername // .jellyfinUsername // .email;
def yes_no: if . == true then "yes" elif . == false then "no" else null end;
def date: if type == "string" and length >= 10 then .[0:10] else null end;
def year: if type == "string" and length >= 4 then .[0:4] else null end;
def one_line: gsub("\\s+"; " ");
def title_year: (.title // .name) + (((.releaseDate // .firstAirDate) | year) as $year | if $year then " (\($year))" else "" end);
def media_title($titles): $titles["\(.mediaType):\(.tmdbId)"];
def media_label($titles): media_title($titles) // (if .tmdbId then "\(.mediaType) \(.tmdbId)" else "unknown title" end);
def results_table:
  ["TYPE", "ID", "TITLE", "YEAR", "STATUS"],
  (.results[] | [.mediaType, .id, (.title // .name), ((.releaseDate // .firstAirDate) | year), (.mediaInfo.status | media_status)]);
def page_footer:
  if .totalResults == 0 then "No results." else "Page \(.page) of \(.totalPages), \(.totalResults) results" end;
def page_info_footer:
  .pageInfo | if .results == 0 then "No results." else "Page \(.page) of \(.pages), \(.results) total" end;
JQ
}

seerr_titles_map() {
  local json=$1 filter=$2
  local dir key count=0
  local -a keys=()

  if [[ -z ${args[--json]:-} ]]; then
    mapfile -t keys < <(jq -r "[$filter | select(.mediaType == \"movie\" or .mediaType == \"tv\") | \"\(.mediaType):\(.tmdbId)\"] | unique[]" <<<"$json")
  fi
  if ((${#keys[@]} == 0)); then
    echo '{}'
    return
  fi

  dir=$(mktemp -d)
  # shellcheck disable=SC2064 # expand $dir now; it is local to this function
  trap "rm -rf '$dir'" EXIT

  for key in "${keys[@]}"; do
    seerr_title_fetch "$key" >"$dir/$count" &
    count=$((count + 1))
    if ((count % 8 == 0)); then
      wait
    fi
  done
  wait

  cat "$dir"/* | jq -sc 'map({(.key): .title}) | add // {}'
  rm -rf "$dir"
  trap - EXIT
}

seerr_title_fetch() {
  seerr_request GET "/${1%%:*}/${1#*:}"
  if [[ $seerr_status == 2?? ]]; then
    jq -c --arg key "$1" "$(seerr_jq_defs) select(.title // .name) | {key: \$key, title: title_year}" <<<"$seerr_body" 2>/dev/null || true
  fi
}

seerr_media_label() {
  local titles

  titles=$(seerr_titles_map "$1" '.media')
  jq -r --argjson titles "$titles" "$(seerr_jq_defs) .media | media_label(\$titles)" <<<"$1"
}

validate_http_client() {
  if [[ -z $1 ]]; then
    return
  fi

  if [[ $1 != curl && $1 != wget ]]; then
    echo "must be curl or wget"
  elif ! command -v "$1" >/dev/null 2>&1; then
    echo "$1 is not installed"
  fi
}

validate_integer() {
  if ! [[ "$1" =~ ^[0-9]+$ ]]; then
    echo "must be an integer"
  fi
}

validate_positive_integer() {
  if ! [[ $1 =~ ^[1-9][0-9]*$ ]]; then
    echo "must be a whole number greater than 0"
  fi
}

validate_seasons() {
  if [[ $1 != all && ! $1 =~ ^[0-9]+(,[0-9]+)*$ ]]; then
    echo "must be 'all' or comma-separated season numbers, e.g. 1,2,3"
  fi
}

validate_url() {
  if [[ -n $1 && ! $1 =~ ^https?:// ]]; then
    echo "must start with http:// or https://, e.g. https://seerr.example.com"
  fi
}

yaml_load() {
  local prefix=$2
  local s='[[:space:]]*' w='[a-zA-Z0-9_]*'
  local fs

  fs=$(echo @ | tr @ '\034')

  sed -ne "s|^\($s\):|\1|" \
    -e "s|^\($s\)\($w\)$s:${s}[\"']\(.*\)[\"']$s\$|\1$fs\2$fs\3|p" \
    -e "s|^\($s\)\($w\)$s:$s\(.*\)$s\$|\1$fs\2$fs\3|p" "$1" |
    awk -F"$fs" '{
      indent = length($1)/2;
      vname[indent] = $2;
      for (i in vname) {if (i > indent) {delete vname[i]}}
      if (length($3) > 0) {
         vn=""; for (i=0; i<indent; i++) {vn=(vn)(vname[i])("_")}
         printf("%s%s%s=\"%s\"\n", "'"$prefix"'",vn, $2, $3);
      }
    }'
}

