seerr_report() {
  if [[ -n ${args[--json]:-} ]]; then
    if [[ -n $1 ]]; then
      jq . <<<"$1"
    fi
  else
    printf '%s\n' "$2"
  fi
}

seerr_columns() {
  if command -v column >/dev/null 2>&1; then
    column -t -s $'\t'
  else
    cat
  fi
